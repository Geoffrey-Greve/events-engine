{
  "name": "paddock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "type-check": "pnpm typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:migrations": "pnpm --filter @paddock/worker check:migrations",
    "check:hubspot-app": "node scripts/check-hubspot-app.mjs",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "deploy:all": "pnpm --filter @paddock/worker deploy && pnpm --filter @paddock/hubspot deploy && pnpm --filter @paddock/checkin-pwa deploy",
    "deploy:staging": "pnpm --filter @paddock/worker deploy:staging && pnpm --filter @paddock/hubspot deploy:staging && pnpm --filter @paddock/checkin-pwa deploy:staging"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "typescript": "^5.8.0",
    "vitest": "~3.2.4"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
